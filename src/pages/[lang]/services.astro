---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, localizedPath } from "../../i18n/utils";
import { ui, type Lang } from "../../i18n/ui";

export function getStaticPaths() {
  return (Object.keys(ui) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const services = [
  "services.list.residential",
  "services.list.commercial",
  "services.list.industrial",
  "services.list.smart",
  "services.list.maintenance",
] as const;
---

<BaseLayout lang={lang} title={t("services.title")} description={t("services.subtitle")} pathInLocale="/services">
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900">{t("services.title")}</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-600">{t("services.subtitle")}</p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((key) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900">{t(`${key}.title` as any)}</h3>
            <p class="mt-2 text-slate-600">{t(`${key}.body` as any)}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href={localizedPath(lang, "/contact")}
          class="inline-flex items-center rounded-md bg-slate-900 px-5 py-3 text-base font-medium text-white hover:bg-slate-800"
        >
          {t("home.hero.ctaPrimary")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
