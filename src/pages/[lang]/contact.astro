---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/utils";
import { ui, type Lang } from "../../i18n/ui";
import ContactForm from "../../components/ContactForm.astro";
import FormScript from "../../components/FormScript.astro";
import { company } from "../../config";

export function getStaticPaths() {
  return (Object.keys(ui) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t("contact.title")} description={t("contact.subtitle")} pathInLocale="/contact">
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900">{t("contact.title")}</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-600">{t("contact.subtitle")}</p>

      <div class="mt-10 grid gap-10 lg:grid-cols-3">
        <div class="space-y-6 text-slate-800">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">{t("contact.address.label")}</p>
            <address class="mt-1 not-italic">
              {company.addressLines.map((line) => <div>{line}</div>)}
            </address>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">{t("contact.phone.label")}</p>
            <a href={`tel:${company.phone.replace(/\s+/g, "")}`} class="mt-1 block hover:text-slate-900">{company.phone}</a>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">{t("contact.email.label")}</p>
            <a href={`mailto:${company.email}`} class="mt-1 block hover:text-slate-900">{company.email}</a>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">{t("contact.hours.label")}</p>
            <p class="mt-1">{t("contact.hours.value")}</p>
          </div>
        </div>

        <div class="lg:col-span-2">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
            <h2 class="text-xl font-semibold text-slate-900">{t("contact.form.title")}</h2>
            <div class="mt-4">
              <ContactForm lang={lang} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FormScript />
</BaseLayout>
