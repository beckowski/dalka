---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, localizedPath } from "../../i18n/utils";
import { ui, type Lang } from "../../i18n/ui";

export function getStaticPaths() {
  return (Object.keys(ui) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const services = [
  { key: "services.list.residential" },
  { key: "services.list.commercial" },
  { key: "services.list.industrial" },
  { key: "services.list.smart" },
  { key: "services.list.maintenance" },
] as const;
---

<BaseLayout lang={lang} title={t("home.hero.title")} description={t("home.hero.subtitle")} pathInLocale="/">
  <section class="relative overflow-hidden bg-[#0a1628] text-white">
    {/* Background image. To use your own photo, replace
        /public/images/background1.jpg — same filename keeps working. */}
    <div class="absolute inset-0" aria-hidden="true">
      <img src="/images/background1.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-55" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0a1628]/95 via-[#0a1628]/80 to-[#0a1628]/50"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a1628]/40 via-transparent to-[#0a1628]/60"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8 lg:py-40">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight drop-shadow sm:text-5xl lg:text-6xl">
          {t("home.hero.title")}
        </h1>
        <p class="mt-6 text-lg text-slate-200 sm:text-xl">
          {t("home.hero.subtitle")}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={localizedPath(lang, "/contact")}
            class="inline-flex items-center rounded-md bg-brand-500 px-5 py-3 text-base font-medium text-white shadow-lg shadow-brand-500/30 hover:bg-brand-600"
          >
            {t("home.hero.ctaPrimary")}
          </a>
          <a
            href={localizedPath(lang, "/services")}
            class="inline-flex items-center rounded-md border border-slate-300/40 bg-white/10 px-5 py-3 text-base font-medium text-white backdrop-blur hover:bg-white/20"
          >
            {t("home.hero.ctaSecondary")}
          </a>
        </div>
      </div>
    </div>

  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight text-slate-900">{t("home.intro.title")}</h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">{t("home.intro.body")}</p>
        </div>
        <div class="grid grid-cols-2 gap-4 text-center">
          {[
            { label: t("home.values.safety.title"), big: "24/7" },
            { label: t("home.values.speed.title"), big: "48h" },
          ].map((stat) => (
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
              <div class="text-2xl font-bold text-slate-900">{stat.big}</div>
              <div class="mt-1 text-sm text-slate-600">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-semibold tracking-tight text-slate-900">{t("home.values.title")}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: t("home.values.quality.title"), body: t("home.values.quality.body") },
          { title: t("home.values.safety.title"), body: t("home.values.safety.body") },
          { title: t("home.values.speed.title"), body: t("home.values.speed.body") },
        ].map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="grid h-10 w-10 place-items-center rounded-lg bg-brand-100 text-brand-700">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/>
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-1 text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-3xl font-semibold tracking-tight text-slate-900">{t("services.title")}</h2>
        <a href={localizedPath(lang, "/services")} class="text-sm font-medium text-brand-700 hover:text-brand-800">→</a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <div class="rounded-xl border border-slate-200 p-6 transition hover:border-slate-300 hover:shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900">{t(`${s.key}.title` as any)}</h3>
            <p class="mt-2 text-slate-600">{t(`${s.key}.body` as any)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#0a1628] text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-2xl font-semibold sm:text-3xl">{t("contact.title")}</h2>
          <p class="mt-2 text-slate-300">{t("contact.subtitle")}</p>
        </div>
        <a
          href={localizedPath(lang, "/contact")}
          class="inline-flex items-center rounded-md bg-brand-500 px-5 py-3 text-base font-medium text-white hover:bg-brand-600"
        >
          {t("home.hero.ctaPrimary")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
