---
import type { LegalPage } from "../i18n/legal";

interface Props {
  page: LegalPage;
}

const { page } = Astro.props;
---

<section class="bg-white">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">{page.title}</h1>
    <p class="mt-2 text-sm text-slate-500">{page.updated}</p>
    <p class="mt-6 text-lg text-slate-600">{page.intro}</p>

    <div class="mt-10 space-y-8">
      {page.sections.map((section) => (
        <div>
          <h2 class="text-xl font-semibold text-slate-900">{section.heading}</h2>
          <div class="mt-2 space-y-3 text-slate-600">
            {section.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
